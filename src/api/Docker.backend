FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# Copy the requirements file using its actual path
COPY src/api/requirements.txt ./src/api/requirements.txt
RUN pip install --no-cache-dir -r ./src/api/requirements.txt

# This copies EVERYTHING under src/ (including api/, config/, and data/)
COPY src/ ./src/

EXPOSE 8000

# Tell Python that /app is the root directory for resolving imports
ENV PYTHONPATH=/app

# Fire up the application factory natively
CMD ["uvicorn", "src.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]