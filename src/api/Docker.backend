FROM python:3.12-slim

WORKDIR /app

# Install system dependencies needed for PostgreSQL/psycopg2 compilation if necessary
RUN apt-get update && apt-get install -y libpq-dev gcc && rm -rf /var/lib/apt/lists/*

# 1. FIX: Point to where requirements.txt lives relative to the project root
COPY src/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2. FIX: Point to your application source code relative to the project root
COPY src/ ./src

EXPOSE 8000

CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8000"]